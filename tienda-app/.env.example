# Sin estas variables la tienda funciona en "modo demostración" (datos en el navegador).
# Con ellas usa Supabase (aplicar antes supabase/migrations/0001_tienda.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# La clave service_role NO se usa en esta app: nunca la pongas aquí ni con prefijo NEXT_PUBLIC_.

# Solo sin Supabase: abre el panel /admin en modo demostración (desarrollo local o preview).
# En producción NO se define: sin base de datos el panel queda cerrado.
NEXT_PUBLIC_TIENDA_PANEL_DEMO=
